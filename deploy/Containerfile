# Build from the repository root after mvn package:
#   podman build -f deploy/Containerfile -t chippy:local .
FROM eclipse-temurin:21-jre
WORKDIR /app
COPY chippy-api/target/chippy.war /app/chippy.war
RUN chgrp -R 0 /app && chmod -R g=u /app
USER 1001
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/chippy.war"]
